# Server Port (Render sets this automatically, default 5001 for local)
PORT=5001

# MongoDB Connection String (from MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/connectify?retryWrites=true&w=majority

# JWT Secret Key for token generation
JWT_SECRET_KEY=your_jwt_secret_key_or_random_hash

# Stream Chat & Video API Credentials
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret

# Frontend URL for CORS (e.g., https://your-app.vercel.app or comma-separated for multiple)
CLIENT_URL=https://your-frontend-domain.vercel.app

# Environment ('production' on Render)
NODE_ENV=production

# Optional: Redis URL for distributed rate limiting (e.g. from Upstash or Render Redis)
# If omitted, will use in-memory rate limiting fallback
# REDIS_URI=rediss://default:password@your-redis-host:6379
